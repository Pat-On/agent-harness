OPENAI_API_KEY=my-key

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1

TAVILY_API_KEY=

LANGCHAIN_API_KEY=lsv2_pt_...your_key_here...
LANGCHAIN_PROJECT=agent-harness
LANGCHAIN_TRACING_V2=true

# A 403 "Forbidden" from LangSmith ("Failed to multipart ingest runs") means the
# key was rejected for writing traces. The agent keeps running; nothing is traced.
#   - EU-region account: uncomment LANGCHAIN_ENDPOINT below.
#   - Expired (default 90 days) or revoked key: create a new personal access token.
#   - Several workspaces, or a read-only (Viewer) role: set LANGSMITH_WORKSPACE_ID
#     to the workspace the key belongs to, with at least an Editor role there.
# LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
